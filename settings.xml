<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!--
        Artifactory (artifactory.opintopolku.fi) on poistettu käytöstä, mutta riippuvuuksien
        omat POMit (java-utils, scala-utils, opiskelijavalinnat-utils, viestinvälityspalvelu)
        määrittelevät sen edelleen repositoryksi. Ohjataan kyseiset repository-id:t
        Github Packagesiin.

        Huom. oph-sade-artifactory2 tulee scala-utils:n POMista (scala-properties_2.11:n parent).
    -->
    <mirrors>
        <mirror>
            <id>github</id>
            <name>Github Packages instead of decommissioned Artifactory</name>
            <url>https://maven.pkg.github.com/opetushallitus/*</url>
            <mirrorOf>github,oph-sade-artifactory,oph-sade-artifactory2,oph-sade-artifactory-snapshots,oph-sade-artifactory-releases,ext-snapshot-local-artifactory-snapshots</mirrorOf>
        </mirror>
    </mirrors>

    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/opetushallitus/*</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>github</id>
            <username>private-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
